<Window x:Class="B0r3dQR.RecentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recent codes" Width="600" Height="660" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Icon="/b0r3dQR;component/assets/b0r3dQR.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="{DynamicResource Back}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="24,18,24,0" Text="Recent codes" FontFamily="Courier New" FontWeight="Bold" FontSize="20" />

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="24,0,24,0">
                <TextBlock x:Name="ProblemLine" TextWrapping="Wrap" Foreground="{DynamicResource Bad}" Visibility="Collapsed" Margin="0,0,0,8"
                           AutomationProperties.LiveSetting="Assertive" />
                <TextBlock x:Name="EmptyLine" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" Visibility="Collapsed" Focusable="True" />
            </StackPanel>
            <ScrollViewer x:Name="ListScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="CodesList" Margin="24,0,24,8" AutomationProperties.Name="Recent codes" />
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Margin="24,10,24,16">
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap" FontSize="12" MinHeight="16" AutomationProperties.LiveSetting="Polite" />
                <CheckBox x:Name="RememberCheck" Content="_Add codes I save, copy or drag out" Margin="0,6,0,0" Checked="OnRemember" Unchecked="OnRemember" />
                <TextBlock x:Name="Footnote" Style="{StaticResource Hint}"
                           Text="Kept only in b0r3d QR's data folder, in b0r3dQR recent.json, and never sent anywhere. Opening a code here shows everything in it, Wi-Fi passwords included; so does that file, to anyone who can open the folder." />
                <DockPanel x:Name="Footer" Margin="0,12,0,0" LastChildFill="False">
                    <TextBlock x:Name="CountLine" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" FontSize="12" />
                    <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="C_lear all" Click="OnClear" Margin="8,0,0,0" />
                    <Button x:Name="CancelClearButton" DockPanel.Dock="Right" Content="Cancel" Click="OnCancelClear" Visibility="Collapsed" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
