<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark: qr.b0r3d.org's dark palette, with its mint for focus and the selected options. -->
    <SolidColorBrush x:Key="Back" Color="#131313" />
    <SolidColorBrush x:Key="Panel" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Stage" Color="#0C0C0C" />
    <SolidColorBrush x:Key="Text" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Dim" Color="#9D9D9D" />
    <SolidColorBrush x:Key="Line" Color="#2C2C2C" />
    <SolidColorBrush x:Key="Field" Color="#1F1F1F" />
    <SolidColorBrush x:Key="FieldLine" Color="#3C3C3C" />
    <SolidColorBrush x:Key="FieldLineHover" Color="#5A5A5A" />
    <SolidColorBrush x:Key="Accent" Color="#00FF9D" />
    <SolidColorBrush x:Key="AccentText" Color="#131313" />
    <SolidColorBrush x:Key="Button" Color="#242424" />
    <SolidColorBrush x:Key="ButtonHover" Color="#2E2E2E" />
    <SolidColorBrush x:Key="ButtonPressed" Color="#383838" />
    <SolidColorBrush x:Key="ButtonLine" Color="#3C3C3C" />
    <SolidColorBrush x:Key="MenuBar" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Menu" Color="#202020" />
    <SolidColorBrush x:Key="MenuHover" Color="#303030" />
    <SolidColorBrush x:Key="MenuHoverText" Color="#E6E6E6" />
    <SolidColorBrush x:Key="MenuLine" Color="#3C3C3C" />
    <SolidColorBrush x:Key="Good" Color="#00E58D" />
    <SolidColorBrush x:Key="Bad" Color="#FF7070" />
    <SolidColorBrush x:Key="Warn" Color="#FFC857" />
    <SolidColorBrush x:Key="Link" Color="#4FD8FF" />
    <SolidColorBrush x:Key="Thumb" Color="#3F3F3F" />
    <SolidColorBrush x:Key="ThumbHover" Color="#5C5C5C" />
    <DropShadowEffect x:Key="TitleGlow" Color="#FF00FF" BlurRadius="18" ShadowDepth="0" Opacity="0.75" />
</ResourceDictionary>
