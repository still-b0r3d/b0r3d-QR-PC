<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light: qr.b0r3d.org's light palette. Every colour here is also in Dark.xaml and
         HighContrast.xaml; Controls.xaml uses them by name. -->
    <SolidColorBrush x:Key="Back" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Panel" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Stage" Color="#E9E9E9" />
    <SolidColorBrush x:Key="Text" Color="#131313" />
    <SolidColorBrush x:Key="Dim" Color="#5C5C5C" />
    <SolidColorBrush x:Key="Line" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Field" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FieldLine" Color="#BDBDBD" />
    <SolidColorBrush x:Key="FieldLineHover" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Accent" Color="#008A55" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Button" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ButtonHover" Color="#E5E5E5" />
    <SolidColorBrush x:Key="ButtonPressed" Color="#D5D5D5" />
    <SolidColorBrush x:Key="ButtonLine" Color="#C2C2C2" />
    <SolidColorBrush x:Key="MenuBar" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Menu" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuHover" Color="#E8E8E8" />
    <SolidColorBrush x:Key="MenuHoverText" Color="#131313" />
    <SolidColorBrush x:Key="MenuLine" Color="#D4D4D4" />
    <SolidColorBrush x:Key="Good" Color="#007A4A" />
    <SolidColorBrush x:Key="Bad" Color="#C62828" />
    <SolidColorBrush x:Key="Warn" Color="#8A5A00" />
    <SolidColorBrush x:Key="Link" Color="#0B62C4" />
    <SolidColorBrush x:Key="Thumb" Color="#C4C4C4" />
    <SolidColorBrush x:Key="ThumbHover" Color="#9A9A9A" />
    <!-- the title's glow, as on the website -->
    <DropShadowEffect x:Key="TitleGlow" Color="#FF00FF" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
</ResourceDictionary>
