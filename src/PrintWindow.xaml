<Window x:Class="B0r3dQR.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:B0r3dQR.Controls"
        Title="Print" Width="760" Height="720" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Icon="/b0r3dQR;component/assets/b0r3dQR.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="{DynamicResource Back}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,18,16,12">
                <TextBlock Text="Print" FontFamily="Courier New" FontWeight="Bold" FontSize="20" />
                <TextBlock x:Name="WhatLine" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Dim}" />

                <TextBlock Style="{StaticResource Label}" Margin="0,16,0,6" Text="On the paper" />
                <RadioButton x:Name="AloneChoice" GroupName="Layout" IsChecked="True" Checked="OnLayout" Margin="0,0,0,6">
                    <AccessText x:Name="AloneText" TextWrapping="Wrap" Text="_Alone, in the middle of the page" />
                </RadioButton>
                <RadioButton x:Name="SheetChoice" GroupName="Layout" Checked="OnLayout">
                    <AccessText x:Name="SheetText" TextWrapping="Wrap" Text="A _sheet of copies" />
                </RadioButton>
                <DockPanel x:Name="CopiesRow" Margin="22,8,0,0">
                    <c:NumberBox x:Name="CopiesBox" DockPanel.Dock="Left" Width="90" Minimum="1" Maximum="1000" Step="1" ValueChanged="OnCopies" AutomationProperties.Name="Copies" />
                    <TextBlock x:Name="CopiesNote" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" />
                </DockPanel>
                <CheckBox x:Name="CaptionsCheck" Content="A _caption under each code" Margin="0,12,0,0" IsChecked="True" Checked="OnLayout" Unchecked="OnLayout" />
                <CheckBox x:Name="MarksCheck" Content="Cut _marks at the corners" Margin="0,8,0,0" IsChecked="True" Checked="OnLayout" Unchecked="OnLayout" />

                <TextBlock Style="{StaticResource Label}" Margin="0,16,0,4" Text="Size" />
                <TextBlock x:Name="SizeLine" TextWrapping="Wrap" />
                <TextBlock x:Name="ShrunkLine" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Warn}" Visibility="Collapsed" />
                <TextBlock Style="{StaticResource Label}" Margin="0,16,0,4" Text="Paper" />
                <TextBlock x:Name="PaperLine" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- the page as it will print -->
        <DockPanel Grid.Column="1" Margin="8,18,24,12">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button x:Name="PreviousButton" DockPanel.Dock="Left" Content="&lt;" MinWidth="36" Click="OnPrevious" AutomationProperties.Name="Previous page" />
                <Button x:Name="NextButton" DockPanel.Dock="Right" Content="&gt;" MinWidth="36" Click="OnNext" AutomationProperties.Name="Next page" />
                <TextBlock x:Name="PageLine" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
            </DockPanel>
            <Border x:Name="Stage" Background="{DynamicResource Stage}" CornerRadius="8" SizeChanged="OnStageSize">
                <Border x:Name="PaperEdge" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <Image x:Name="PagePicture" AutomationProperties.Name="The page as it will print" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,10,24,16" LastChildFill="False">
                <TextBlock x:Name="StatusLine" DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="OnClose" />
                <Button x:Name="PrintButton" DockPanel.Dock="Right" Content="_Print…" IsDefault="True" Click="OnPrint" Margin="0,0,8,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
