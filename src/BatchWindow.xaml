<Window x:Class="B0r3dQR.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch export" Width="660" Height="760" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Icon="/b0r3dQR;component/assets/b0r3dQR.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="{DynamicResource Back}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,18,24,0">
            <TextBlock Text="Batch export" FontFamily="Courier New" FontWeight="Bold" FontSize="20" />
            <TextBlock x:Name="WhatLine" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Dim}" />
        </StackPanel>

        <ScrollViewer x:Name="Scroll" Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,0,24,12">
                <!-- the CSV -->
                <DockPanel>
                    <Button x:Name="ChooseButton" DockPanel.Dock="Left" Content="_Choose a CSV file…" Click="OnChoose" />
                    <Button x:Name="ExampleButton" DockPanel.Dock="Right" Content="Save an _example…" Click="OnExample" Margin="8,0,0,0" />
                    <TextBlock x:Name="FileLine" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="DropHint" Style="{StaticResource Hint}" Text="Or drop a CSV file on this window." />
                <TextBlock x:Name="ReadProblem" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource Bad}" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Assertive" />
                <Expander x:Name="GuideSection" Style="{StaticResource Section}" Header="What goes in the CSV" IsExpanded="False">
                    <TextBlock x:Name="GuideText" TextWrapping="Wrap" />
                </Expander>

                <!-- the rows: those that can't be made first, then each row in turn -->
                <StackPanel x:Name="RowsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="ProblemsHeading" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Bad}" />
                    <ItemsControl x:Name="ProblemsList" Margin="0,4,0,0" AutomationProperties.Name="Rows that can't be made" />
                    <Border Margin="0,10,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button x:Name="PreviousButton" DockPanel.Dock="Left" Content="&lt;" MinWidth="36" Click="OnPrevious" AutomationProperties.Name="Previous row" />
                                <Button x:Name="NextButton" DockPanel.Dock="Right" Content="&gt;" MinWidth="36" Click="OnNext" AutomationProperties.Name="Next row" />
                                <TextBlock x:Name="RowNumber" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                            </DockPanel>
                            <Border DockPanel.Dock="Right" Width="150" Height="150" Margin="12,0,0,0" CornerRadius="4" Background="{DynamicResource Stage}">
                                <Image x:Name="RowPicture" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="This row's code" />
                            </Border>
                            <StackPanel x:Name="RowFields" />
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- the files -->
                <TextBlock Style="{StaticResource Label}" Margin="0,16,0,6" Text="Kind of file" />
                <WrapPanel x:Name="Formats">
                    <RadioButton x:Name="PngChoice" Style="{StaticResource Segment}" Content="_PNG" GroupName="Format" IsChecked="True" Checked="OnFormat" Margin="0,0,6,6" />
                    <RadioButton x:Name="JpgChoice" Style="{StaticResource Segment}" Content="_JPG" GroupName="Format" Checked="OnFormat" Margin="0,0,6,6" />
                    <RadioButton x:Name="SvgChoice" Style="{StaticResource Segment}" Content="_SVG" GroupName="Format" Checked="OnFormat" Margin="0,0,6,6" />
                    <RadioButton x:Name="PdfChoice" Style="{StaticResource Segment}" Content="P_DF" GroupName="Format" Checked="OnFormat" Margin="0,0,6,6" />
                    <RadioButton x:Name="TextChoice" Style="{StaticResource Segment}" Content="_Text" GroupName="Format" Checked="OnFormat" Margin="0,0,6,6" />
                </WrapPanel>
                <StackPanel x:Name="TextOptions" Orientation="Horizontal" Visibility="Collapsed" Margin="0,2,0,0">
                    <ComboBox x:Name="TextStyleBox" Width="220" SelectionChanged="OnTextStyle" AutomationProperties.Name="Kind of text" />
                    <CheckBox x:Name="MarkdownCheck" Content="Markdo_wn (.md)" Margin="12,0,0,0" VerticalAlignment="Center" Checked="OnTextStyle" Unchecked="OnTextStyle" />
                </StackPanel>
                <CheckBox x:Name="FrameCheck" Content="_Frame each code with its row's caption" Margin="0,10,0,0" Checked="OnFrame" Unchecked="OnFrame" />
                <TextBlock x:Name="SettingsLine" Style="{StaticResource Hint}" />

                <TextBlock Style="{StaticResource Label}" Margin="0,16,0,6" Text="Put them" />
                <WrapPanel>
                    <RadioButton x:Name="FolderChoice" Style="{StaticResource Segment}" Content="Into a f_older" GroupName="Into" IsChecked="True" Margin="0,0,6,6" Padding="10,0" />
                    <RadioButton x:Name="ZipChoice" Style="{StaticResource Segment}" Content="Into a _zip file" GroupName="Into" Margin="0,0,6,6" Padding="10,0" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Every file is read back once it's written, to check it scans as its row says." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Margin="24,10,24,16">
                <!-- asked once, when some of the files are already in the folder -->
                <Border x:Name="ClashPanel" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="ClashLine" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="NumberButton" Content="_Number the new ones" Click="OnNumber" Margin="0,0,8,6" />
                            <Button x:Name="ReplaceButton" Content="_Replace them" Click="OnReplace" Margin="0,0,8,6" />
                            <Button x:Name="SkipButton" Content="S_kip them" Click="OnSkip" Margin="0,0,8,6" />
                            <Button x:Name="BackButton" Content="Don't make them" Click="OnClashCancel" Margin="0,0,8,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusLine" TextWrapping="Wrap" MinHeight="18" AutomationProperties.LiveSetting="Polite" />
                <ItemsControl x:Name="OutcomeList" Margin="0,4,0,0" AutomationProperties.Name="Files that didn't come out right" />
                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                    <Button x:Name="MakeButton" DockPanel.Dock="Left" Content="_Make the files…" Click="OnMake" IsEnabled="False" />
                    <Button x:Name="PrintButton" DockPanel.Dock="Left" Content="Print t_hem…" Click="OnPrintRows" Margin="8,0,0,0" IsEnabled="False" />
                    <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="Stop" Click="OnStop" Margin="8,0,0,0" Visibility="Collapsed" />
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="OnClose" />
                    <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Content="Show the f_iles" Click="OnOpenFolder" Margin="0,0,8,0" Visibility="Collapsed" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
