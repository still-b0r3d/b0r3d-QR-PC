<Window x:Class="B0r3dQR.TemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data to encode" Width="600" Height="680" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Icon="/b0r3dQR;component/assets/b0r3dQR.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="{DynamicResource Back}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="24,18,24,0">
            <Button x:Name="ExampleButton" DockPanel.Dock="Right" Content="Use _example" Click="OnExample" VerticalAlignment="Center"
                    ToolTip="Fill in this template with an example" />
            <TextBlock Text="Data to encode" FontFamily="Courier New" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="24,14,24,0">
            <Label Style="{StaticResource LabelFor}" Target="{Binding ElementName=TypeBox}" Content="Data _type" Margin="0,0,0,4" />
            <ComboBox x:Name="TypeBox" SelectionChanged="OnType" AutomationProperties.Name="Data type" />
        </StackPanel>

        <ScrollViewer x:Name="FieldsScroll" Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="FieldsPanel" Margin="24,0,24,12" />
        </ScrollViewer>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,12,24,16" LastChildFill="False">
                <TextBlock x:Name="RequiredNote" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" FontSize="12" />
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="_Save" IsDefault="True" Click="OnSave" Margin="8,0,0,0" MinWidth="88" />
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" IsCancel="True" MinWidth="88" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
