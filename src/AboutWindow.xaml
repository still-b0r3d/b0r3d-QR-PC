<Window x:Class="B0r3dQR.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About b0r3d QR" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/b0r3dQR;component/assets/b0r3dQR.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Root" Background="{DynamicResource Back}">
        <StackPanel Margin="24,22,24,20">
            <DockPanel>
                <Image x:Name="CupPicture" DockPanel.Dock="Left" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="b0r3d QR" FontFamily="Courier New" FontWeight="Bold" FontSize="26" Effect="{DynamicResource TitleGlow}" />
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource Dim}" Margin="0,2,0,0" />
                    <TextBlock Margin="0,2,0,0">
                        <Run Text="Made by" /> <Hyperlink Click="OnMaker">b0r3d.org</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <TextBlock TextWrapping="Wrap" Margin="0,18,0,0"
                       Text="Makes static QR codes: what you type goes straight into the pattern, so a code never expires and never stops working. b0r3d QR never goes online, and nothing you type is sent anywhere." />

            <TextBlock Style="{StaticResource Heading}" Text="Settings folder" />
            <DockPanel>
                <Button x:Name="OpenFolder" DockPanel.Dock="Right" Content="_Open" Click="OnOpenFolder" Margin="12,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="FolderText" TextWrapping="Wrap" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Style="{StaticResource Heading}" Text="Licences" />
            <!-- the licence files keep their own line breaks -->
            <TextBox x:Name="Licences" IsReadOnly="True" Height="200" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" AutomationProperties.Name="Licences" />

            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="90" />
        </StackPanel>
    </Border>
</Window>
