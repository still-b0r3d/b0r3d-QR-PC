<UserControl x:Class="B0r3dQR.Controls.NumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="30" Focusable="False">
    <Border x:Name="Box" Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldLine}" BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Field" Style="{StaticResource BareField}" Padding="6,0,2,0" InputScope="Number"
                     PreviewKeyDown="OnKey" LostKeyboardFocus="OnLeave" PreviewMouseWheel="OnWheel" />
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <RepeatButton x:Name="Up" Style="{StaticResource Spin}" Click="OnUp">
                    <Path Data="M0,4 L4,0 L8,4" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
                </RepeatButton>
                <RepeatButton x:Name="Down" Grid.Row="1" Style="{StaticResource Spin}" Click="OnDown">
                    <Path Data="M0,0 L4,4 L8,0" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" />
                </RepeatButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
