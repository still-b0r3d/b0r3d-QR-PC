<Window x:Class="B0r3dQR.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan with the camera" Width="720" Height="620" MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Icon="/b0r3dQR;component/assets/b0r3dQR.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Background="{DynamicResource Back}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- the name, and a list of the cameras when there's more than one -->
        <DockPanel Margin="24,18,24,0">
            <StackPanel x:Name="CameraRow" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                <Label Style="{StaticResource LabelFor}" Content="_Camera" Target="{Binding ElementName=CameraBox}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ComboBox x:Name="CameraBox" Width="240" SelectionChanged="OnCamera" AutomationProperties.Name="Camera" />
            </StackPanel>
            <TextBlock Text="Scan with the camera" FontFamily="Courier New" FontWeight="Bold" FontSize="20" VerticalAlignment="Center" />
        </DockPanel>

        <!-- what the camera sees, with a frame to aim with (any part of it is read), as on the website -->
        <Border x:Name="Stage" Grid.Row="1" Margin="24,14,24,0" CornerRadius="8" Background="Black" MinHeight="300" ClipToBounds="True">
            <Grid>
                <Grid x:Name="View" HorizontalAlignment="Center" VerticalAlignment="Center" SizeChanged="OnViewSize">
                    <Image x:Name="PictureView" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Camera view" />
                    <Path x:Name="Veil" Fill="#40000000" IsHitTestVisible="False" Visibility="Collapsed" />
                    <Border x:Name="Viewfinder" BorderBrush="#CCFFFFFF" BorderThickness="2" CornerRadius="12" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <TextBlock x:Name="StartingText" Text="Starting the camera…" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <StackPanel x:Name="ProblemPanel" VerticalAlignment="Center" Margin="32,20" Visibility="Collapsed">
                    <TextBlock x:Name="ProblemText" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource Bad}"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock x:Name="DetailText" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource Dim}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="HintText" Grid.Row="2" Style="{StaticResource Hint}" Margin="24,8,24,0"
                   Text="Hold a code up to the camera: the first one it sees goes to the Scan tab. Nothing the camera sees is saved." />

        <Border Grid.Row="3" Margin="0,12,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,10,24,16" LastChildFill="False">
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Click="OnCancel" ToolTip="Close the camera (Esc)" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
