<Window x:Class="B0r3dQR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:B0r3dQR"
        xmlns:c="clr-namespace:B0r3dQR.Controls"
        Title="b0r3d QR" Width="1000" Height="680" MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Icon="/b0r3dQR;component/assets/b0r3dQR.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AllowDrop="True" PreviewDragEnter="OnPreviewDragOver" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnPreviewDrop"
        DragEnter="OnDragElsewhere" DragOver="OnDragElsewhere" Drop="OnDragElsewhere"
        PreviewKeyDown="OnPreviewKeys" KeyDown="OnKeys">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:Commands.SavePng}" Executed="OnSavePng" CanExecute="WhenThereIsACode" />
        <CommandBinding Command="{x:Static local:Commands.SaveSvg}" Executed="OnSaveSvg" CanExecute="WhenThereIsACode" />
        <CommandBinding Command="{x:Static local:Commands.CopyPicture}" Executed="OnCopyPicture" CanExecute="WhenThereIsACode" />
        <CommandBinding Command="{x:Static local:Commands.SaveJpg}" Executed="OnSaveJpg" CanExecute="WhenThereIsACode" />
        <CommandBinding Command="{x:Static local:Commands.SavePdf}" Executed="OnSavePdf" CanExecute="WhenThereIsACode" />
        <CommandBinding Command="{x:Static local:Commands.SaveText}" Executed="OnSaveText" CanExecute="WhenThereIsAQrCode" />
        <CommandBinding Command="{x:Static local:Commands.CopySvg}" Executed="OnCopySvg" CanExecute="WhenThereIsACode" />
        <CommandBinding Command="{x:Static local:Commands.CopyText}" Executed="OnCopyText" CanExecute="WhenThereIsAQrCode" />
        <CommandBinding Command="{x:Static local:Commands.OpenDesign}" Executed="OnOpenDesign" />
        <CommandBinding Command="{x:Static local:Commands.SaveDesign}" Executed="OnSaveDesign" CanExecute="WhenMakingQr" />
        <CommandBinding Command="{x:Static local:Commands.ScanScreen}" Executed="OnScanScreen" CanExecute="WhenNotScanning" />
        <CommandBinding Command="{x:Static local:Commands.OpenPicture}" Executed="OnOpenPicture" CanExecute="WhenNotScanning" />
        <CommandBinding Command="{x:Static local:Commands.PastePicture}" Executed="OnPastePicture" CanExecute="WhenNotScanning" />
        <CommandBinding Command="{x:Static local:Commands.ScanFolder}" Executed="OnScanFolder" CanExecute="WhenNotScanning" />
        <CommandBinding Command="{x:Static local:Commands.About}" Executed="OnAbout" />
    </Window.CommandBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Shown" />

        <!-- one code found by a scan; or, in a batch, a picture with no code or that couldn't be
             read (no text and no buttons, its title in the warning colour). Screen readers get
             each card's and button's name from its Label: "Link, b0r3d.org", never a password. -->
        <DataTemplate x:Key="FoundCard">
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                    AutomationProperties.Name="{Binding Label}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" Background="White" CornerRadius="4" Margin="0,0,14,0" VerticalAlignment="Top"
                            Visibility="{Binding HasThumbnail, Converter={StaticResource Shown}}" ToolTip="{Binding ThumbnailTip}">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Kind}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" Margin="0,8,0,0"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="What the code holds"
                                 Visibility="{Binding HasText, Converter={StaticResource Shown}}" />
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsCode, Converter={StaticResource Shown}}">
                            <Button Content="Copy text" Click="OnCopyFound" Margin="0,0,8,0"
                                    AutomationProperties.Name="{Binding Label, StringFormat='Copy text ({0})'}" />
                            <Button Content="Open link…" Click="OnOpenFound" Margin="0,0,8,0" Visibility="{Binding IsWebLink, Converter={StaticResource Shown}}"
                                    AutomationProperties.Name="{Binding Label, StringFormat='Open link ({0})'}" />
                            <Button Content="Make this code again" Click="OnMakeAgain" Visibility="{Binding CanMakeAgain, Converter={StaticResource Shown}}"
                                    AutomationProperties.Name="{Binding Label, StringFormat='Make this code again ({0})'}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel x:Name="Root" Background="{DynamicResource Back}">
        <!-- Access keys: F E N V H on the bar, M A for the tabs; then S G C and the sections D T L R Z
             on Make, S O P D L C on Scan; each menu list has its own. -->
        <Menu x:Name="MenuBar" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Save _PNG…" Command="{x:Static local:Commands.SavePng}" />
                <MenuItem Header="Save _JPG…" Command="{x:Static local:Commands.SaveJpg}" />
                <MenuItem Header="Save _SVG…" Command="{x:Static local:Commands.SaveSvg}" />
                <MenuItem Header="Save P_DF…" Command="{x:Static local:Commands.SavePdf}" />
                <MenuItem Header="Save as _text…" Command="{x:Static local:Commands.SaveText}" />
                <Separator />
                <MenuItem Header="_Open design…" Command="{x:Static local:Commands.OpenDesign}" />
                <MenuItem Header="Save desi_gn…" Command="{x:Static local:Commands.SaveDesign}" />
                <MenuItem x:Name="RecentMenu" Header="_Recent codes…" Click="OnRecent" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" />
                <Separator />
                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" />
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" />
                <MenuItem Header="Select _all" Command="ApplicationCommands.SelectAll" />
                <Separator />
                <MenuItem Header="Copy p_icture" Command="{x:Static local:Commands.CopyPicture}" />
                <MenuItem Header="Copy as S_VG" Command="{x:Static local:Commands.CopySvg}" />
                <MenuItem Header="Copy as te_xt" Command="{x:Static local:Commands.CopyText}" />
            </MenuItem>
            <MenuItem Header="Sca_n">
                <MenuItem Header="Scan the _screen" Command="{x:Static local:Commands.ScanScreen}" />
                <MenuItem Header="_Open picture…" Command="{x:Static local:Commands.OpenPicture}" />
                <MenuItem Header="_Paste picture" Command="{x:Static local:Commands.PastePicture}" />
                <MenuItem Header="Scan a fol_der…" Command="{x:Static local:Commands.ScanFolder}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Look">
                    <MenuItem x:Name="LookWindows" Header="Like _Windows" IsCheckable="True" Tag="Windows" Click="OnLook" />
                    <MenuItem x:Name="LookLight" Header="_Light" IsCheckable="True" Tag="Light" Click="OnLook" />
                    <MenuItem x:Name="LookDark" Header="_Dark" IsCheckable="True" Tag="Dark" Click="OnLook" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About b0r3d QR" Command="{x:Static local:Commands.About}" />
                <Separator />
                <MenuItem Header="b0r3d._org" Click="OnMaker" />
            </MenuItem>
        </Menu>

        <!-- the bottom line: notes on the left, the version on the right -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource MenuBar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Dim}" Margin="16,0,0,0">
                    <Run x:Name="VersionRun" /><Run Text=" · " /><Hyperlink Click="OnMaker">b0r3d.org</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="Note" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <TabControl x:Name="Tabs" Padding="210,4,14,0" SelectionChanged="OnTabChanged">
                <TabItem x:Name="MakeTab" Header="_Make">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="370" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- the settings, in fold-out sections like the website's -->
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                            <ScrollViewer x:Name="MakeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Margin="20,10,20,20">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontFamily="Courier New"
                                               Text="Static codes: nothing expires, nothing is sent anywhere." />

                                    <!-- QR codes, or one of the website's other barcode types -->
                                    <DockPanel Margin="0,12,0,0">
                                        <Label x:Name="CodeTypeLabel" Style="{StaticResource LabelFor}" Content="Code t_ype" Target="{Binding ElementName=CodeTypeBox}"
                                               DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CodeTypeBox" SelectionChanged="OnCodeType" AutomationProperties.Name="Code type" />
                                    </DockPanel>

                                    <StackPanel x:Name="QrPanel">
                                    <Expander x:Name="DataSection" Style="{StaticResource Section}" Header="_Data" IsExpanded="True">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Data templates" />
                                            <DockPanel Margin="0,0,0,10">
                                                <Button x:Name="EditTemplateButton" DockPanel.Dock="Right" Content="Edit…" Click="OnEditTemplate" Margin="8,0,0,0"
                                                        ToolTip="Edit data template" AutomationProperties.Name="Open data type generator" />
                                                <Grid>
                                                    <ComboBox x:Name="TemplateBox" SelectionChanged="OnTemplate" DropDownOpened="OnTemplateOpened" DropDownClosed="OnTemplateClosed"
                                                              AutomationProperties.Name="Data templates" />
                                                    <TextBlock x:Name="TemplateHint" Text="Select template..." IsHitTestVisible="False" Margin="9,0,30,0"
                                                               VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                </Grid>
                                            </DockPanel>
                                            <Grid>
                                                <TextBox x:Name="DataBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" Height="96"
                                                         VerticalScrollBarVisibility="Auto" TextChanged="OnDataChanged" AutomationProperties.Name="Data" />
                                                <TextBlock x:Name="DataHint" Text="Type or paste a link, or any text" Foreground="{DynamicResource Dim}"
                                                           Margin="8,5,0,0" IsHitTestVisible="False" />
                                            </Grid>
                                            <StackPanel x:Name="DataChecksPanel" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="StyleSection" Style="{StaticResource Section}" Header="S_tyle" IsExpanded="True">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button x:Name="RandomizeButton" DockPanel.Dock="Right" Content="Randomize" Click="OnRandomize" Margin="8,0,0,0"
                                                        ToolTip="Random shapes and colours. The logo, sizes and frame stay." />
                                                <ComboBox x:Name="PresetBox" SelectionChanged="OnPreset" AutomationProperties.Name="Preset" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="Dots" />
                                            <DockPanel>
                                                <c:ColorBox x:Name="DotsColorBox" DockPanel.Dock="Right" Margin="8,0,0,0" ColorChanged="OnPartColour" AutomationProperties.Name="Dots colour" />
                                                <ComboBox x:Name="DotsTypeBox" SelectionChanged="OnPartShape" AutomationProperties.Name="Dots shape" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="Corner squares" />
                                            <DockPanel>
                                                <c:ColorBox x:Name="SquaresColorBox" DockPanel.Dock="Right" Margin="8,0,0,0" ColorChanged="OnPartColour" AutomationProperties.Name="Corner squares colour" />
                                                <ComboBox x:Name="SquaresTypeBox" SelectionChanged="OnPartShape" AutomationProperties.Name="Corner squares shape" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Label}" Text="Corner dots" />
                                            <DockPanel>
                                                <c:ColorBox x:Name="CentresColorBox" DockPanel.Dock="Right" Margin="8,0,0,0" ColorChanged="OnPartColour" AutomationProperties.Name="Corner dots colour" />
                                                <ComboBox x:Name="CentresTypeBox" SelectionChanged="OnPartShape" AutomationProperties.Name="Corner dots shape" />
                                            </DockPanel>
                                            <DockPanel Margin="0,14,0,0">
                                                <c:ColorBox x:Name="BackgroundColorBox" DockPanel.Dock="Right" Margin="8,0,0,0" ColorChanged="OnPartColour" AutomationProperties.Name="Background colour" />
                                                <CheckBox x:Name="BackgroundCheck" Content="With _background" VerticalAlignment="Center" Checked="OnBackground" Unchecked="OnBackground" />
                                            </DockPanel>
                                            <DockPanel Margin="0,10,0,0">
                                                <c:NumberBox x:Name="RadiusBox" DockPanel.Dock="Right" Width="90" Minimum="0" Maximum="10000" ValueChanged="OnRadius"
                                                             AutomationProperties.Name="Rounded corners in pixels" />
                                                <TextBlock Text="Rounded corners (px)" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="LogoSection" Style="{StaticResource Section}" Header="_Logo" AllowDrop="True">
                                        <StackPanel>
                                            <WrapPanel>
                                                <Button x:Name="ChooseLogoButton" Content="Ch_oose…" Click="OnChooseLogo" AutomationProperties.Name="Choose a logo" Margin="0,0,8,0" />
                                                <Button x:Name="PasteLogoButton" Content="_Paste" Click="OnPasteLogo" AutomationProperties.Name="Paste a logo" Margin="0,0,8,0" />
                                                <Button x:Name="RemoveLogoButton" Content="Remove" Click="OnRemoveLogo" AutomationProperties.Name="Remove the logo" />
                                            </WrapPanel>
                                            <TextBlock x:Name="LogoNote" Style="{StaticResource Hint}"
                                                       Text="Or drop a picture here. It goes in the middle, and the dots behind it are left out." />
                                            <DockPanel Margin="0,12,0,0">
                                                <TextBlock x:Name="LogoSizeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Text="Size" Width="40" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                <Slider x:Name="LogoSizeSlider" Minimum="0" Maximum="0.5" SmallChange="0.05" LargeChange="0.05" TickFrequency="0.05"
                                                        IsSnapToTickEnabled="True" ValueChanged="OnLogoSize" AutomationProperties.Name="Logo size" />
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,0">
                                                <c:NumberBox x:Name="LogoSpaceBox" DockPanel.Dock="Right" Width="90" Minimum="0" Maximum="40" Step="0.5" Decimals="2"
                                                             ValueChanged="OnLogoSpace" AutomationProperties.Name="Logo space in modules" />
                                                <TextBlock Text="Space around it (modules)" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <TextBlock x:Name="LogoHint" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="FrameSection" Style="{StaticResource Section}" Header="F_rame">
                                        <StackPanel>
                                            <CheckBox x:Name="FrameCheck" Content="Add a frame _with a caption" Checked="OnFrameOn" Unchecked="OnFrameOn" />
                                            <StackPanel x:Name="FramePanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                <ComboBox x:Name="FramePresetBox" SelectionChanged="OnFramePreset" AutomationProperties.Name="Frame preset" />
                                                <TextBlock Style="{StaticResource Label}" Text="Caption" />
                                                <TextBox x:Name="CaptionBox" AcceptsReturn="True" TextWrapping="Wrap" Height="52" VerticalScrollBarVisibility="Auto"
                                                         TextChanged="OnCaption" AutomationProperties.Name="Caption" />
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <RadioButton x:Name="FrameTop" Style="{StaticResource Segment}" Content="top" GroupName="FramePlace" Tag="top" AutomationProperties.Name="Caption on top" Checked="OnFramePlace" />
                                                    <RadioButton x:Name="FrameBottom" Style="{StaticResource Segment}" Content="bottom" GroupName="FramePlace" Tag="bottom" AutomationProperties.Name="Caption at the bottom" Checked="OnFramePlace" />
                                                    <RadioButton x:Name="FrameRight" Style="{StaticResource Segment}" Content="right" GroupName="FramePlace" Tag="right" AutomationProperties.Name="Caption on the right" Checked="OnFramePlace" />
                                                    <RadioButton x:Name="FrameLeft" Style="{StaticResource Segment}" Content="left" GroupName="FramePlace" Tag="left" AutomationProperties.Name="Caption on the left" Checked="OnFramePlace" />
                                                </StackPanel>
                                                <DockPanel x:Name="FrameWidthRow" Margin="0,8,0,0" Visibility="Collapsed">
                                                    <c:NumberBox x:Name="FrameWidthBox" DockPanel.Dock="Right" Width="90" Minimum="250" Maximum="800" Step="10"
                                                                 ValueChanged="OnFrameWidth" AutomationProperties.Name="Frame width in pixels" />
                                                    <TextBlock Text="Frame width (px)" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="Text, background and border colours" />
                                                <WrapPanel>
                                                    <c:ColorBox x:Name="FrameTextColorBox" Margin="0,0,8,6" ColorChanged="OnFrameColour" AutomationProperties.Name="Caption colour" />
                                                    <c:ColorBox x:Name="FrameBackColorBox" Margin="0,0,8,6" ColorChanged="OnFrameColour" AutomationProperties.Name="Frame background colour" />
                                                    <c:ColorBox x:Name="FrameBorderColorBox" Margin="0,0,8,6" ColorChanged="OnFrameColour" AutomationProperties.Name="Frame border colour" />
                                                </WrapPanel>
                                                <WrapPanel>
                                                    <Button x:Name="FramePictureButton" Content="Background picture…" Click="OnFramePicture" Margin="0,0,8,0" />
                                                    <Button x:Name="FrameNoPictureButton" Content="No picture" Click="OnFrameNoPicture" />
                                                </WrapPanel>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="Border" Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,0,0,3" />
                                                        <TextBox x:Name="FrameBorderBox" LostKeyboardFocus="OnFrameLength" KeyDown="OnFrameLengthKey" AutomationProperties.Name="Frame border width" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Corners" Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,0,0,3" />
                                                        <TextBox x:Name="FrameRadiusBox" LostKeyboardFocus="OnFrameLength" KeyDown="OnFrameLengthKey" AutomationProperties.Name="Frame corner radius" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Padding" Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,0,0,3" />
                                                        <TextBox x:Name="FramePaddingBox" LostKeyboardFocus="OnFrameLength" KeyDown="OnFrameLengthKey" AutomationProperties.Name="Frame padding" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Style="{StaticResource Label}" Text="Caption font" />
                                                <ComboBox x:Name="FontBox" SelectionChanged="OnFont" AutomationProperties.Name="Caption font" />
                                                <TextBlock x:Name="FrameNote" Style="{StaticResource Hint}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander x:Name="SizeSection" Style="{StaticResource Section}" Header="Si_ze and print" IsExpanded="True">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Label}" Margin="0,0,0,4" Text="Error correction" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="LevelL" Style="{StaticResource Segment}" Content="L" GroupName="Level" Tag="L" Checked="OnLevel" AutomationProperties.Name="Level L, low" />
                                                <RadioButton x:Name="LevelM" Style="{StaticResource Segment}" Content="M" GroupName="Level" Tag="M" Checked="OnLevel" AutomationProperties.Name="Level M, medium" />
                                                <RadioButton x:Name="LevelQ" Style="{StaticResource Segment}" Content="Q" GroupName="Level" Tag="Q" Checked="OnLevel" AutomationProperties.Name="Level Q, high" />
                                                <RadioButton x:Name="LevelH" Style="{StaticResource Segment}" Content="H" GroupName="Level" Tag="H" Checked="OnLevel" AutomationProperties.Name="Level H, highest" />
                                            </StackPanel>
                                            <TextBlock x:Name="LevelHint" Style="{StaticResource Hint}" />
                                            <TextBlock Style="{StaticResource Label}" Text="Size of the code (QR version)" />
                                            <ComboBox x:Name="VersionBox" SelectionChanged="OnVersion" AutomationProperties.Name="QR version" />
                                            <TextBlock x:Name="VersionHint" Style="{StaticResource Hint}" />
                                            <CheckBox x:Name="MarkerCheck" Content="Mark the text as _UTF-8 (ECI 26)" Margin="0,12,0,0" Checked="OnMarker" Unchecked="OnMarker" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Tells scanners how to read accents, other alphabets and emoji, as the QR standard asks. Phones read them fine without it, and a few older scanners show the mark as extra characters, so test it before printing many." />
                                            <TextBlock x:Name="MarkerNote" Style="{StaticResource Hint}" Foreground="{DynamicResource Warn}" Visibility="Collapsed"
                                                       Text="Couldn't add the UTF-8 marker, so this code is made without it." />
                                            <DockPanel Margin="0,12,0,0">
                                                <c:NumberBox x:Name="QuietBox" DockPanel.Dock="Right" Width="90" Minimum="0" Maximum="20" Decimals="1" ValueChanged="OnQuietChanged"
                                                             AutomationProperties.Name="Quiet zone in modules" />
                                                <TextBlock Text="Quiet zone (modules)" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="4 is the standard (ISO/IEC 18004): scanners need blank space around a code to find it." />
                                            <DockPanel Margin="0,12,0,0">
                                                <c:NumberBox x:Name="SizeBox" DockPanel.Dock="Right" Width="100" Minimum="50" Maximum="4000" Step="50" ValueChanged="OnSizeChanged"
                                                             AutomationProperties.Name="Picture size in pixels" />
                                                <TextBlock Text="Picture size (px)" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                            </DockPanel>
                                            <CheckBox x:Name="WholePixelsCheck" Content="Whole pi_xels per module" Margin="0,8,0,0" Checked="OnWholePixels" Unchecked="OnWholePixels" />
                                            <TextBlock x:Name="SizeHint" Style="{StaticResource Hint}" />
                                            <CheckBox x:Name="PrintCheck" Content="Size for pr_int" Margin="0,12,0,0" Checked="OnPrint" Unchecked="OnPrint" />
                                            <StackPanel x:Name="PrintPanel" Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                    <c:NumberBox x:Name="PrintWidthBox" Width="90" Minimum="0.01" Maximum="1000" Decimals="2" ValueChanged="OnPrintChanged"
                                                                 AutomationProperties.Name="Print width" />
                                                    <ComboBox x:Name="PrintUnitBox" Width="64" Margin="6,0,0,0" SelectionChanged="OnPrintUnit" AutomationProperties.Name="Unit" />
                                                    <ComboBox x:Name="PrintDpiBox" Width="104" Margin="6,0,0,0" SelectionChanged="OnPrintChanged" AutomationProperties.Name="Resolution" />
                                                </StackPanel>
                                                <TextBlock x:Name="PrintHint" Style="{StaticResource Hint}" />
                                                <TextBlock x:Name="PrintWarn" Style="{StaticResource Hint}" Foreground="{DynamicResource Warn}" Visibility="Collapsed" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                    </StackPanel>

                                    <!-- a barcode: plain, colours and size only, as on the website -->
                                    <StackPanel x:Name="BarcodePanel" Visibility="Collapsed">
                                        <Expander x:Name="BarcodeDataSection" Style="{StaticResource Section}" Header="_Data" IsExpanded="True">
                                            <StackPanel>
                                                <TextBox x:Name="BarcodeDataBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" Height="56"
                                                         VerticalScrollBarVisibility="Auto" TextChanged="OnBarcodeDataChanged" AutomationProperties.Name="Data to encode" />
                                                <TextBlock x:Name="BarcodeHint" Style="{StaticResource Hint}" />
                                                <TextBlock x:Name="BarcodeError" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource Bad}"
                                                           Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
                                            </StackPanel>
                                        </Expander>

                                        <Expander x:Name="BarcodeLookSection" Style="{StaticResource Section}" Header="Barcode se_ttings" IsExpanded="True">
                                            <StackPanel>
                                                <StackPanel x:Name="LinearOptions">
                                                    <CheckBox x:Name="ShowTextCheck" Content="Show the te_xt under the bars" Checked="OnBarcodeOption" Unchecked="OnBarcodeOption" />
                                                    <StackPanel x:Name="QuietZonesRow">
                                                        <CheckBox x:Name="QuietZonesCheck" Content="Include _quiet zones (margins)" Margin="0,8,0,0" Checked="OnBarcodeOption" Unchecked="OnBarcodeOption" />
                                                        <TextBlock x:Name="QuietZonesNote" Style="{StaticResource Hint}" Foreground="{DynamicResource Warn}" Visibility="Collapsed"
                                                                   Text="Leave blank space on both sides where you place it, about 10 times the thinnest bar: scanners need it to find the code." />
                                                    </StackPanel>
                                                    <DockPanel Margin="0,10,0,0">
                                                        <c:NumberBox x:Name="BarHeightBox" DockPanel.Dock="Right" Width="90" Minimum="20" Maximum="150" Step="5" Decimals="2" Fallback="50" ValueChanged="OnBarHeight"
                                                                     AutomationProperties.Name="Bar height in modules" />
                                                        <TextBlock Text="Bar height (modules)" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource Hint}" Text="20 to 150; the default is 50." />
                                                </StackPanel>
                                                <CheckBox x:Name="RectangularCheck" Visibility="Collapsed" Checked="OnBarcodeOption" Unchecked="OnBarcodeOption">
                                                    <AccessText TextWrapping="Wrap" Text="Allow a _rectangular code (narrower; fewer scanners read it)" />
                                                </CheckBox>
                                                <DockPanel Margin="0,14,0,0">
                                                    <c:ColorBox x:Name="BarsColorBox" DockPanel.Dock="Right" ColorChanged="OnBarcodeColour" AutomationProperties.Name="Bars colour" />
                                                    <TextBlock Text="Bars" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <DockPanel Margin="0,8,0,0">
                                                    <c:ColorBox x:Name="BarcodeBackgroundBox" DockPanel.Dock="Right" ColorChanged="OnBarcodeColour" AutomationProperties.Name="Background colour" />
                                                    <TextBlock Text="Background" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <CheckBox x:Name="TransparentCheck" Content="Transparent _background" Margin="0,8,0,0" Checked="OnBarcodeOption" Unchecked="OnBarcodeOption" />
                                                <DockPanel Margin="0,12,0,0">
                                                    <c:NumberBox x:Name="ScaleBox" DockPanel.Dock="Right" Width="90" Minimum="1" Maximum="20" Step="1" Decimals="2" Fallback="4" ValueChanged="OnBarcodeScale"
                                                                 AutomationProperties.Name="Size in pixels per module" />
                                                    <TextBlock Text="Size (pixels per module)" VerticalAlignment="Center" Foreground="{DynamicResource Dim}" />
                                                </DockPanel>
                                                <TextBlock x:Name="ScaleHint" Style="{StaticResource Hint}" />
                                                <CheckBox x:Name="BarcodePrintCheck" Content="Size for pr_int" Margin="0,12,0,0" Checked="OnBarcodePrintOn" Unchecked="OnBarcodePrintOn" />
                                                <StackPanel x:Name="BarcodePrintPanel" Visibility="Collapsed">
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <c:NumberBox x:Name="BarcodePrintWidthBox" Width="90" Minimum="0.01" Maximum="1000" Decimals="2" ValueChanged="OnBarcodePrint"
                                                                     AutomationProperties.Name="Print width" />
                                                        <ComboBox x:Name="BarcodePrintUnitBox" Width="64" Margin="6,0,0,0" SelectionChanged="OnBarcodePrintUnit" AutomationProperties.Name="Unit" />
                                                        <ComboBox x:Name="BarcodePrintDpiBox" Width="104" Margin="6,0,0,0" SelectionChanged="OnBarcodePrint" AutomationProperties.Name="Resolution" />
                                                    </StackPanel>
                                                    <TextBlock x:Name="BarcodePrintHint" Style="{StaticResource Hint}" />
                                                    <TextBlock x:Name="BarcodePrintWarn" Style="{StaticResource Hint}" Foreground="{DynamicResource Warn}" Visibility="Collapsed" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                                   Text="Barcodes are made by the rules of zint, the website's barcode maker, and checked with ZXing.Net. Help → About has their licences." />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- the code -->
                        <Grid Grid.Column="1" Margin="24,18,24,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="Stage" Background="{DynamicResource Stage}" CornerRadius="8" SizeChanged="OnStageSize">
                                <Grid>
                                    <Image x:Name="Preview" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                           ToolTip="Drag the code into another program, or into a folder as a PNG file"
                                           MouseLeftButtonDown="OnPreviewDown" MouseMove="OnPreviewMove" AutomationProperties.Name="The QR code" />
                                    <TextBlock x:Name="StageNote" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="380" Margin="20" Foreground="{DynamicResource Dim}" />
                                    <!-- shown once, after the first code goes to Recent codes, so keeping codes is never a surprise -->
                                    <Border x:Name="RecentNote" VerticalAlignment="Bottom" Margin="12" Padding="14,10" CornerRadius="6" Visibility="Collapsed"
                                            Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="RecentNoteText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                                                       Text="Added to Recent codes, so you can open it again later. It is kept only in b0r3d QR's data folder on this PC and never sent anywhere." />
                                            <TextBlock x:Name="RecentNoteProblem" TextWrapping="Wrap" Foreground="{DynamicResource Bad}" Visibility="Collapsed" Margin="0,6,0,0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                <Button x:Name="RecentNoteStop" Content="Don't keep codes" Click="OnNoteStop" Margin="0,0,8,0" />
                                                <Button x:Name="RecentNoteView" Content="View" Click="OnNoteView" Margin="0,0,8,0" />
                                                <Button x:Name="RecentNoteOk" Content="OK" Click="OnNoteOk" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="2,12,2,0">
                                <TextBlock x:Name="CheckLine" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="WarnLine" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InfoLine" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Expander x:Name="InCodeSection" Style="{StaticResource Section}" Header="What's in this code" Margin="0,0,0,0">
                                    <StackPanel>
                                        <Grid x:Name="InCodeRows">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                        <TextBox x:Name="InCodeText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="80" Margin="0,8,0,0" FontFamily="Consolas"
                                                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="The text in the code" />
                                        <TextBlock x:Name="InCodeFooter" Style="{StaticResource Hint}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                                <Button x:Name="SavePngButton" Content="_Save PNG…" Command="{x:Static local:Commands.SavePng}" Margin="0,0,8,0" />
                                <Button x:Name="SaveSvgButton" Content="Save SV_G…" Command="{x:Static local:Commands.SaveSvg}" Margin="0,0,8,0" />
                                <Button x:Name="CopyButton" Content="_Copy picture" Command="{x:Static local:Commands.CopyPicture}" Margin="0,0,8,0" />
                                <Button x:Name="RecentButton" Content="Recent codes…" Click="OnRecent" Margin="0,0,12,0" />
                                <TextBlock Text="or drag the code into another program" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem x:Name="ScanTab" Header="Sc_an">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="370" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- where to read from -->
                        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Margin="20,10,20,20">
                                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontFamily="Courier New"
                                               Text="Read QR codes and barcodes. Pictures stay on this PC." />

                                    <TextBlock Style="{StaticResource Heading}" Text="Off the screen" />
                                    <Button x:Name="ScanScreenButton" Content="Scan the _screen" Command="{x:Static local:Commands.ScanScreen}" HorizontalAlignment="Stretch" />
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="b0r3d QR steps aside and every screen freezes. Drag a box around a code, or click a screen to read all of it. Enter reads every screen; Esc cancels." />

                                    <TextBlock Style="{StaticResource Heading}" Text="From pictures" />
                                    <Button x:Name="OpenPictureButton" Content="_Open picture…" Command="{x:Static local:Commands.OpenPicture}" HorizontalAlignment="Stretch" />
                                    <Button x:Name="PastePictureButton" Content="_Paste picture" Command="{x:Static local:Commands.PastePicture}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                                    <Button x:Name="ScanFolderButton" Content="Scan a fol_der…" Command="{x:Static local:Commands.ScanFolder}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                               Text="Or drop pictures or a folder anywhere on this window, or press Ctrl+V with a picture copied. PNG, JPEG, BMP, GIF and TIFF, and WebP or HEIC where Windows can open them. For a PDF, open it and scan the screen." />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- what was found -->
                        <Grid Grid.Column="1" Margin="24,18,24,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="C_lear" Click="OnClearFound" Margin="8,0,0,0" />
                                <Button x:Name="CancelScanButton" DockPanel.Dock="Right" Content="_Cancel" Click="OnCancelScan" Margin="8,0,0,0" Visibility="Collapsed"
                                        ToolTip="Stop reading (Esc)" />
                                <TextBlock x:Name="ScanStatus" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            </DockPanel>
                            <Border Grid.Row="1" Background="{DynamicResource Stage}" CornerRadius="8" Margin="0,12,0,0">
                                <Grid>
                                    <ScrollViewer x:Name="FoundScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                        <ItemsControl x:Name="FoundList" ItemTemplate="{StaticResource FoundCard}" Margin="12,12,12,2" Focusable="False">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock x:Name="FoundHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="380" Margin="20" Foreground="{DynamicResource Dim}"
                                               Text="Codes you read show up here." />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- the name, on the tab strip -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,4,0,0" IsHitTestVisible="False">
                <Image x:Name="CupPicture" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                <TextBlock Text="b0r3d QR" FontFamily="Courier New" FontWeight="Bold" FontSize="20" Margin="9,0,0,0" VerticalAlignment="Center" Effect="{DynamicResource TitleGlow}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
