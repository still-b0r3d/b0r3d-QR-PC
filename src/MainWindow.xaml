<Window x:Class="B0r3dQR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:B0r3dQR"
        xmlns:c="clr-namespace:B0r3dQR.Controls"
        Title="b0r3d QR" Width="1000" Height="660" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="/b0r3dQR;component/assets/b0r3dQR.ico"
        Background="{DynamicResource Back}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:Commands.SavePng}" Executed="OnSavePng" CanExecute="WhenThereIsACode" />
        <CommandBinding Command="{x:Static local:Commands.SaveSvg}" Executed="OnSaveSvg" CanExecute="WhenThereIsACode" />
        <CommandBinding Command="{x:Static local:Commands.CopyPicture}" Executed="OnCopyPicture" CanExecute="WhenThereIsACode" />
        <CommandBinding Command="{x:Static local:Commands.About}" Executed="OnAbout" />
    </Window.CommandBindings>

    <DockPanel x:Name="Root" Background="{DynamicResource Back}">
        <!-- Access keys: F E V H on the bar; S G C for the buttons; each list has its own. -->
        <Menu x:Name="MenuBar" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Save _PNG…" Command="{x:Static local:Commands.SavePng}" />
                <MenuItem Header="Save _SVG…" Command="{x:Static local:Commands.SaveSvg}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" />
                <Separator />
                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" />
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" />
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" />
                <MenuItem Header="Select _all" Command="ApplicationCommands.SelectAll" />
                <Separator />
                <MenuItem Header="Copy p_icture" Command="{x:Static local:Commands.CopyPicture}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Look">
                    <MenuItem x:Name="LookWindows" Header="Like _Windows" IsCheckable="True" Tag="Windows" Click="OnLook" />
                    <MenuItem x:Name="LookLight" Header="_Light" IsCheckable="True" Tag="Light" Click="OnLook" />
                    <MenuItem x:Name="LookDark" Header="_Dark" IsCheckable="True" Tag="Dark" Click="OnLook" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About b0r3d QR" Command="{x:Static local:Commands.About}" />
                <Separator />
                <MenuItem Header="b0r3d._org" Click="OnMaker" />
            </MenuItem>
        </Menu>

        <!-- the bottom line: notes on the left, the version on the right -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource MenuBar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Dim}" Margin="16,0,0,0">
                    <Run x:Name="VersionRun" /><Run Text=" · " /><Hyperlink Click="OnMaker">b0r3d.org</Hyperlink>
                </TextBlock>
                <TextBlock x:Name="Note" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the settings -->
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="20,16,20,20">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="CupPicture" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <TextBlock Text="b0r3d QR" FontFamily="Courier New" FontWeight="Bold" FontSize="23" Margin="10,0,0,0" VerticalAlignment="Center" Effect="{DynamicResource TitleGlow}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" FontFamily="Courier New"
                                   Text="Static codes: nothing expires, nothing is sent anywhere." />

                        <TextBlock Style="{StaticResource Heading}" Text="Data" />
                        <Grid>
                            <TextBox x:Name="DataBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" Height="104"
                                     VerticalScrollBarVisibility="Auto" TextChanged="OnDataChanged" AutomationProperties.Name="Data" />
                            <TextBlock x:Name="DataHint" Text="Type or paste a link, or any text" Foreground="{DynamicResource Dim}"
                                       Margin="8,5,0,0" IsHitTestVisible="False" />
                        </Grid>

                        <TextBlock Style="{StaticResource Heading}" Text="Error correction" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LevelL" Style="{StaticResource Segment}" Content="L" GroupName="Level" Tag="L" Checked="OnLevel" AutomationProperties.Name="Level L, low" />
                            <RadioButton x:Name="LevelM" Style="{StaticResource Segment}" Content="M" GroupName="Level" Tag="M" Checked="OnLevel" AutomationProperties.Name="Level M, medium" />
                            <RadioButton x:Name="LevelQ" Style="{StaticResource Segment}" Content="Q" GroupName="Level" Tag="Q" Checked="OnLevel" AutomationProperties.Name="Level Q, quartile" />
                            <RadioButton x:Name="LevelH" Style="{StaticResource Segment}" Content="H" GroupName="Level" Tag="H" Checked="OnLevel" AutomationProperties.Name="Level H, high" />
                        </StackPanel>
                        <TextBlock x:Name="LevelHint" Style="{StaticResource Hint}" />

                        <TextBlock Style="{StaticResource Heading}" Text="Quiet zone" />
                        <StackPanel Orientation="Horizontal">
                            <c:NumberBox x:Name="QuietBox" Width="84" Minimum="0" Maximum="20" ValueChanged="OnQuietChanged" AutomationProperties.Name="Quiet zone in modules" />
                            <TextBlock Text="modules of white around the code" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="4 is the standard: scanners need white space around a code to find it." />

                        <TextBlock Style="{StaticResource Heading}" Text="Picture size" />
                        <StackPanel Orientation="Horizontal">
                            <c:NumberBox x:Name="SizeBox" Width="100" Minimum="100" Maximum="4000" Step="100" ValueChanged="OnSizeChanged" AutomationProperties.Name="Picture size in pixels" />
                            <TextBlock Text="pixels across" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="SizeHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- the code -->
            <Grid Grid.Column="1" Margin="24,18,24,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="Stage" Background="{DynamicResource Stage}" CornerRadius="8" SizeChanged="OnStageSize">
                    <Grid>
                        <Image x:Name="Preview" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                               ToolTip="Drag the code into another program, or into a folder as a PNG file"
                               MouseLeftButtonDown="OnPreviewDown" MouseMove="OnPreviewMove" AutomationProperties.Name="The QR code" />
                        <TextBlock x:Name="StageNote" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="380" Margin="20" Foreground="{DynamicResource Dim}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="2,12,2,0">
                    <TextBlock x:Name="CheckLine" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="WarnLine" Foreground="{DynamicResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="InfoLine" Foreground="{DynamicResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button x:Name="SavePngButton" Content="_Save PNG…" Command="{x:Static local:Commands.SavePng}" Margin="0,0,8,0" />
                    <Button x:Name="SaveSvgButton" Content="Save SV_G…" Command="{x:Static local:Commands.SaveSvg}" Margin="0,0,8,0" />
                    <Button x:Name="CopyButton" Content="_Copy picture" Command="{x:Static local:Commands.CopyPicture}" Margin="0,0,12,0" />
                    <TextBlock Text="or drag the code into another program" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                </WrapPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
